#!/bin/sh
# Thin shim: Node >=22.18 runs the TypeScript source directly (type stripping).
# Resolve symlinks (e.g. `npm link` or ~/bin/deveggs -> here) to find the repo.
SELF="$0"
while [ -L "$SELF" ]; do
  LINK="$(readlink "$SELF")"
  case "$LINK" in /*) SELF="$LINK" ;; *) SELF="$(dirname "$SELF")/$LINK" ;; esac
done
DIR="$(cd -P "$(dirname "$SELF")/.." && pwd -P)"
# Basket scripts as subcommands: `deveggs lease` and `deveggs mem` run the basket's
# scripts/lease and scripts/mem. exec, so signals (a timeout's TERM, Ctrl-C) reach the
# script itself, which stops its command's process group.
case "$1" in
  lease|mem)
    BASKET="${DEVEGGS_BASKET:-$HOME/.deveggs}"
    if [ -f "$BASKET/scripts/$1" ]; then
      SCRIPT="$BASKET/scripts/$1"
      shift
      exec bash "$SCRIPT" "$@"
    fi
    echo "deveggs: $1 runs your basket's scripts/$1, and $BASKET has none" >&2
    exit 1 ;;
esac
exec node --disable-warning=ExperimentalWarning "$DIR/src/cli.ts" "$@"
